# KiCad transient / auto-generated files
_autosave-*
*-backups/
*-cache.lib
*-rescue.lib
*-rescue.dcm
*.kicad_sch-bak
*.sch-bak
fp-info-cache

# Arduino IDE build output (Sketch > Export Compiled Binary)
arduino/**/build/

# Claude Code local config
.claude/

# Desktop app (Electron): dependencies and build output
arduino/v2/desktop/node_modules/
arduino/v2/desktop/dist/
# ...but the desktop app keeps its icons in build/
!arduino/v2/desktop/build/

# Server release tarballs (built with git archive for deploy; the tag is the source of truth)
server-v*.tar.gz
