# DRAFT template for /etc/cosmicray/env  (owner root, group cosmicray, mode 0640)
# systemd EnvironmentFile format: KEY=value, no quotes, no "export".
#
# Never commit the real file, and never paste JWT_SECRET into a chat or a ticket.
NODE_ENV=production
HOST=127.0.0.1
PORT=3100
DATA_DIR=/var/lib/cosmicray

# Generate once on the server:  openssl rand -base64 48
# Changing it signs every participant out (their tokens stop working).
JWT_SECRET=CHANGE_ME

# Password hashing: OWASP minimum for scrypt. ~128 MiB per hash; CONCURRENCY of them at once.
# Size CONCURRENCY from the VPS's free memory (see the survey): 2 needs ~256 MiB of headroom.
SCRYPT_N=131072
SCRYPT_CONCURRENCY=2

# Shown to old accounts that must register an email before they can log in (Phase 4).
CLAIM_URL=https://cosmicray.accel-kitchen.com/claim

# ---------------------------------------------------------------------------------------------
# Added with server 0.2.0 (self-registration, the public map and the graphs).
# Every default below is the SAFE one: nothing needs to be set to run exactly as before.
# Note: systemd does not support a comment after a value, so every comment is on its own line.
# ---------------------------------------------------------------------------------------------

# Where the links in the mails point.
PUBLIC_URL=https://cosmicray.accel-kitchen.com

# Self-registration is CLOSED unless this is 1. Do not open it until the checklist in deploy/README.md is done:
# the terms text approved, a real mail delivered to the addresses participants use, backups running.
REGISTRATION_OPEN=0

# The terms text people agree to. Keep the word "draft" in the name until the text has been approved.
CONSENT_VERSION=draft-1

# 0 = an operator puts a confirmed station on the public map (scripts/admin.js list-on <id>).
# 1 = a station goes on the map by itself once its address is confirmed.
AUTO_LIST_ON_VERIFY=0

# Map background: none (default, nothing is sent to a third party) | gsi (Geospatial Information Authority
# of Japan tiles) | osm (OpenStreetMap tiles). gsi and osm pass the viewer's address to that provider.
MAP_TILE=none

# Registrations never confirmed within this many days are removed, which frees their station id again.
UNVERIFIED_DAYS=7

# Mail. Needed (as smtp) when REGISTRATION_OPEN=1. The choice of route is open: a Postfix on this machine,
# Google Workspace, or an outside service all work through SMTP (plan, Q-N1).
MAIL_TRANSPORT=none
MAIL_FROM=CosmicRay <noreply@accel-kitchen.com>
#SMTP_HOST=localhost
#SMTP_PORT=587
#SMTP_SECURE=0
#SMTP_USER=
# SMTP_PASS is a secret: set it only here, never in a chat or a ticket.
#SMTP_PASS=
# The most mails sent to one address in a day, and in total in a day.
MAIL_PER_ADDRESS_PER_DAY=5
MAIL_GLOBAL_PER_DAY=300

# Operator page: how long an operator login lasts (seconds). Operators are created with scripts/admin.js admin-create.
#ADMIN_TOKEN_TTL_S=7200
